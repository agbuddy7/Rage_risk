# ==========================================
# LLM & AI Risk Manager Configuration
# ==========================================

# Your LLM API Key (e.g. OpenRouter, OpenAI, Groq, etc.)
LLM_API_KEY=your_llm_api_key_here

# Rebuff LLM Guardrail settings (defaults to LLM_API_KEY if not specified)
REBUFF_LLM_API_KEY=your_llm_api_key_here
REBUFF_LLM_API_URL=https://openrouter.ai/api/v1
REBUFF_LLM_MODEL=openai/gpt-oss-120b

# Ledger Risk Detection thresholds
LEDGER_DEFENSE_MODE=enforce
LEDGER_MODEL_THRESHOLD_HIGH=0.80
LEDGER_MODEL_THRESHOLD_MED=0.60
